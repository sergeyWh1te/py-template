ENV=local
# Also the metric prefix: py-template -> py_template_metric_build_info_total.
APP_NAME=py-template
# The port the app listens on when run on the host (`make serve`). Inside the
# compose network the service always listens on 8080; compose publishes it on
# this port, so the host side is the same either way.
PORT=8082
# json selects the JSON renderer; anything else gives logfmt-style text.
LOG_FORMAT=text
# debug | info | warn | error — an unrecognized value falls back to info.
LOG_LEVEL=debug
# true: ignore this file and read config from the process environment only
# (how the service runs in Docker and CI). Read from the shell, never from here.
# READ_ENV_FROM_SHELL=false
# COMMIT (shown in the build_info metric) is deliberately absent: the image
# bakes it in at build time (Dockerfile ARG COMMIT -> ENV COMMIT) and `make
# serve` exports it from git. A `COMMIT=` line here would reach the container
# through env_file and blank the baked-in value.

PG_PORT=5434
# Host-side value, used by `make serve`, migrations and psql. docker-compose
# overrides this with the `postgres` service name for the containerized service.
PG_HOST=127.0.0.1
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_DATABASE=master
PG_SCHEMA=public
PG_SSLMODE=disable
